{
  "schema_version": 2,
  "base_branch": "master",
  "workflow_branch_prefix": "workflow/",
  "integration_branch_prefix": "integration/",
  "worktree_root": "../.workflow-worktrees",
  "runtime_dir": ".workflow/runtime",
  "run_id_format": "WF-YYYYMMDD-NNN-slug",
  "candidate_freeze_required": true,
  "single_writer_per_worktree": true,
  "allow_cross_agent_takeover": true,
  "auto_memory_policy": "disabled",
  "raw_logs_tracked": false
}
