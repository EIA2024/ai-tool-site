# AI Tool Site — Root environment variables
# Used by docker-compose; individual services also have their own .env.example
# At minimum set DEEPSEEK_API_KEY — it is required by the AI-powered tools.

# Deployment mode: "dev" or "production"
APP_ENV=dev

# Backend
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API (browser origin).
APP_CORS_ORIGINS=http://localhost:5173

# Frontend
FRONTEND_PORT=5173
# Browser-side base URL for API calls. Defaults to the host-published backend.
#VITE_API_BASE=http://localhost:8000/api

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_tool_site
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Model providers — DeepSeek is the default provider; set its key at minimum.
DEEPSEEK_API_KEY=

# Model-provider registry (JSON list). Override to add or swap OpenAI-compatible
# providers (OpenAI, GLM, Moonshot/Kimi, Qwen, ...) — no code change needed.
# Each entry: id, name, base_url, api_key_env (the Settings field holding that
# provider's key), models, default_model, plus optional limits. Unset → the
# built-in default (DeepSeek only). Empty value → same (ignored, uses default).
#LLM_PROVIDERS=[{"id":"deepseek","name":"DeepSeek","base_url":"https://api.deepseek.com","api_key_env":"deepseek_api_key","models":["deepseek-v4-flash","deepseek-v4-pro"],"default_model":"deepseek-v4-flash","max_output_tokens":384000,"context_length":1000000,"session_key_prefix":"sk-","supports_thinking":true}]
#LLM_DEFAULT_PROVIDER=deepseek
# Empty → the default provider's own default model.
#LLM_DEFAULT_MODEL=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
# Total invoke budget across all clients per minute (bounds model spend).
RATE_LIMIT_GLOBAL_PER_MINUTE=200
# Set true only when running behind a reverse proxy that overwrites
# X-Forwarded-For; otherwise leave false so the header cannot be spoofed.
TRUST_PROXY_HEADERS=false
