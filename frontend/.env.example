# Frontend environment variables
# Copy to .env and customize if needed.

# Base path for backend API calls and origin for realtime WebSocket calls.
# Default (unset): "/api" — same-origin. In dev, Vite proxies /api -> :8000.
# For a standalone production build talking to a remote backend, set the
# full origin, e.g. https://api.example.com/api
VITE_API_BASE=/api
