# Backend environment variables
# Copy to .env and fill in values. See app/core/config.py for the full
# Settings model; values not listed here fall back to their defaults.

# App
APP_NAME=AI Tool Site
APP_VERSION=0.1.0
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173

# Database
# Local non-Docker dev can use SQLite via `python run_dev.py` (sets its own
# DATABASE_URL); Docker Compose overrides this with the Postgres DSN.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_tool_site

# Redis (used by the cache layer and the optional rate limiter)
REDIS_URL=redis://localhost:6379/0

# Model providers — DeepSeek is the default provider; set its key at minimum.
DEEPSEEK_API_KEY=

# Model-provider registry (JSON list). Override to add or swap OpenAI-compatible
# providers (OpenAI, GLM, Moonshot/Kimi, Qwen, ...) — no code change needed.
# Each entry: id, name, base_url, api_key_env, models, default_model, plus
# optional limits (max_output_tokens, context_length, session_key_prefix,
# supports_thinking, extra_headers, api_style). See the docs handbook's
# "Adding a model provider" section. Unset → the built-in default (DeepSeek).
#LLM_PROVIDERS=[{"id":"deepseek","name":"DeepSeek","base_url":"https://api.deepseek.com","api_key_env":"deepseek_api_key","models":["deepseek-v4-flash","deepseek-v4-pro"],"default_model":"deepseek-v4-flash","max_output_tokens":384000,"context_length":1000000,"session_key_prefix":"sk-","supports_thinking":true}]
#LLM_DEFAULT_PROVIDER=deepseek
# Empty → the default provider's own default model.
#LLM_DEFAULT_MODEL=

# Security / rate limiting
# Optional bearer token for GET /api/audit/tool-calls?include_details=true.
# Leave empty to disable retrieval of raw audit input/output.
AUDIT_OPERATOR_TOKEN=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
# Total invoke budget across all clients per minute (bounds model spend).
RATE_LIMIT_GLOBAL_PER_MINUTE=200
# Set true only when running behind a reverse proxy that overwrites
# X-Forwarded-For; otherwise leave false so the header cannot be spoofed
# to bypass per-IP rate limiting.
TRUST_PROXY_HEADERS=false
