# Backend environment variables
# Copy to .env and fill in values. See app/core/config.py for the full
# Settings model; values not listed here fall back to their defaults.

# App
APP_NAME=AI Tool Site
APP_VERSION=0.1.0
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173

# Database
# Local non-Docker dev can use SQLite via `python run_dev.py` (sets its own
# DATABASE_URL); Docker Compose overrides this with the Postgres DSN.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_tool_site

# Redis (used by the cache layer and the optional rate limiter)
REDIS_URL=redis://localhost:6379/0

# DeepSeek — required for AI-powered tools
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash

# Security / rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
